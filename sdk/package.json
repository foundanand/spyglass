{
  "name": "@foundanand/spyglass-sdk",
  "version": "0.0.1",
  "description": "Tiny telemetry SDK for spyglass: events, session replay, flow timing, errors, and bug reports. ~4KB gzipped core; rrweb loads lazily.",
  "keywords": [
    "analytics",
    "telemetry",
    "session-replay",
    "rrweb",
    "error-tracking",
    "product-analytics",
    "self-hosted",
    "spyglass"
  ],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/foundanand/spyglass#readme",
  "bugs": {
    "url": "https://github.com/foundanand/spyglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foundanand/spyglass.git",
    "directory": "sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size-check": "node size-check.mjs",
    "prepublishOnly": "node build.ts && node size-check.mjs"
  },
  "dependencies": {
    "@rrweb/rrweb-plugin-console-record": "^2.0.1",
    "rrweb": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
